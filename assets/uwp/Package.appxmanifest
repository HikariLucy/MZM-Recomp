<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap mp rescap">

  <Identity Name="MZMRecompiled"
            Publisher="CN=MZMRecompiledDev"
            Version="0.4.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MZM Recompiled</DisplayName>
    <PublisherDisplayName>MZM Recompiled Community</PublisherDisplayName>
    <Logo>assets\icons\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows.Universal covers Windows 10/11 Desktop and Xbox One / Xbox Series X|S -->
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="MZMRecomp.exe"
                 EntryPoint="MZMRecomp.App">
      <uap:VisualElements DisplayName="MZM Recompiled"
                          Description="MZM Recompiled for Xbox Series X|S"
                          BackgroundColor="#070b12"
                          Square150x150Logo="assets\icons\Square150x150Logo.png"
                          Square44x44Logo="assets\icons\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\icons\Wide310x150Logo.png"
                         Square71x71Logo="assets\icons\Square71x71Logo.png" />
        <uap:SplashScreen Image="assets\icons\SplashScreen.png"
                          BackgroundColor="#070b12" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- Minimal capabilities: Pure offline local execution, zero network telemetry -->
  <Capabilities>
  </Capabilities>

</Package>
